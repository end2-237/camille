{
  "expo": {
    "name": "Camille",
    "slug": "camille-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECECEC",
    "icon": "./assets/icon.png",
    "runtimeVersion": { "policy": "sdkVersion" },
    "updates": { "enabled": false, "fallbackToCacheTimeout": 0, "checkAutomatically": "ON_LOAD" },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      ["./plugins/withSplashColor", { "color": "#ECECEC" }]
    ],
    "android": {
      "package": "com.camille.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101012"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "apiBaseUrl": "https://camille.vps.buyticle.com"
    }
  }
}
