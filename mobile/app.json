{
  "expo": {
    "name": "Camille",
    "slug": "camille-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECECEC",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/ba055ab9-efe1-466d-984d-262230c48b78",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "./plugins/withSplashColor",
        {
          "color": "#ECECEC"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#101012",
          "defaultChannel": "commandes"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "android": {
      "package": "com.camille.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101012"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "apiBaseUrl": "https://camille.vps.buyticle.com",
      "eas": {
        "projectId": "ba055ab9-efe1-466d-984d-262230c48b78"
      }
    },
    "owner": "onedev237"
  }
}