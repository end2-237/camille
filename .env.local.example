# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — Camille by Buyticle
# Copy to .env.local and fill in your values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL (self-hosted) ──────────────────────────────────
DATABASE_URL=postgresql://postgres:buyticle@172.16.16.4:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── LLM Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
